                "user",
                "{{userId}}"
              ]
            },
            "description": "清理测试数据。删除后可再次查询列表确认记录已消失。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('业务码 200', () => pm.expect(pm.response.json().code).to.eql(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 角色与组织",
      "description": "覆盖角色、菜单、部门、岗位、字典五类基础数据的查询接口，验证鉴权后数据可见性。",
      "item": [
        {
          "name": "查询角色列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/system/role/list?pageNum=1&pageSize=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "role",
                "list"
              ],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('业务码 200', () => pm.expect(pm.response.json().code).to.eql(200));",
                  "pm.test('角色列表非空', () => pm.expect(pm.response.json().rows).to.be.an('array').and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "查询菜单列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/system/menu/list?pageNum=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "menu",
                "list"
              ],
              "query": [
                {
                  "key": "pageNum",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            },
            "description": "验证菜单配置数据的完整结构。"
          },
          "event": [
            {
              "listen": "test",
